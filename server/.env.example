PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/prodexa_db"

# Security & Session Secrets (32+ random characters)
JWT_SECRET="your_secure_random_jwt_secret_key_2026"
AUDIT_HMAC_SECRET="your_secure_audit_hmac_secret_2026"

# Frontend Application Origin (for CORS & Redirections)
CLIENT_URL="http://localhost:5173"

# Google Gemini AI Studio API Key (Optional: system has automatic fallback)
GEMINI_API_KEY=""

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
